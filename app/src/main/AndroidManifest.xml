<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_theme_1"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_theme_1"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".HealthConnectRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewHealthPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".HealthConnectRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize" />

        <!-- 듀오링고 스타일 10가지 동적 앱 아이콘 테마 Activity Aliases -->
        <!-- 1. 기본 정상 아이콘 (EyeOverlay AI) -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_1"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 2. 피곤한 눈 아이콘 (장시간 미사용/피로도 높음 😴) -->
        <activity-alias
            android:name=".MainActivityTired"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_2"
            android:label="피곤한 눈 😴 - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 3. 불타는 눈 아이콘 (3일 연속 눈 운동 스트릭 🔥) -->
        <activity-alias
            android:name=".MainActivityFire"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_3"
            android:label="불타는 눈 🔥 - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 4. 황금 왕관 아이콘 (Lv.3 이상 골드 챔피언 🏆) -->
        <activity-alias
            android:name=".MainActivityGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_4"
            android:label="황금 챔피언 🏆 - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 5. 사이버 네온 아이콘 (사이버펑크 네온 ⚡) -->
        <activity-alias
            android:name=".MainActivityCyber"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_5"
            android:label="사이버 네온 ⚡ - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 6. 깜빡이는 눈 아이콘 (깜빡임 마스터 👁️) -->
        <activity-alias
            android:name=".MainActivityBlink"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_6"
            android:label="깜빡임 마스터 👁️ - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 7. 에메랄드 포레스트 아이콘 (자연 휴식 🌲) -->
        <activity-alias
            android:name=".MainActivityEmerald"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_7"
            android:label="에메랄드 🌲 - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 8. 아메지스트 크리스탈 아이콘 (자수정 🔮) -->
        <activity-alias
            android:name=".MainActivityAmethyst"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_8"
            android:label="아메지스트 🔮 - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 9. 루비 레드 집중 아이콘 (루비 레드 🔴) -->
        <activity-alias
            android:name=".MainActivityRuby"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_9"
            android:label="루비 레드 🔴 - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 10. 시리우스 은하 아이콘 (갤럭시 스페이스 🌌) -->
        <activity-alias
            android:name=".MainActivityGalaxy"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_theme_10"
            android:label="시리우스 은하 🌌 - IrisFit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".reminder.BreakReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.CareReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.IrisFitWidget1Provider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/iris_fit_widget_info_1" />
        </receiver>

    </application>

</manifest>